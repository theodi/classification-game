HOST=mlgame.local.org
MONGO_URI=mongodb://localhost:27017/ClassificationGameSchool
MONGO_DB=ClassificationGameSchool
SSLKEY=key.pem
SSLCERT=cert.pem
PORT=8000
SECUREPORT=3443
ADMIN_EMAIL=teacher@example.com
SESSION_SECRET=change-this-secret
RESULT_RETENTION_DAYS=365

# Email (same options as learning-orchestrator; pick one method)
# Recommended: Gmail via service account domain-wide delegation
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Classification Game
EMAIL_USER=noreply@example.com
EMAIL_USE_SERVICE_ACCOUNT=true
EMAIL_USE_OAUTH2=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Or Gmail OAuth2
# EMAIL_USE_SERVICE_ACCOUNT=false
# EMAIL_USE_OAUTH2=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Or SMTP (set EMAIL_USE_OAUTH2=false and EMAIL_USE_SERVICE_ACCOUNT=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
