<%- include('../partials/header') %>
<section class="content-block white">
  <div class="container">
    <div class="page-title"><h1>Request an account</h1></div>
    <div class="infobox">
      <p>Teachers are usually added by their school. Use this form only if you need a self-paced account or an admin needs to review you.</p>
      <form id="request-form">
        <label for="email">Email</label>
        <input id="email" type="email" required>
        <fieldset>
          <legend>Account type</legend>
          <label><input type="radio" name="requestedType" value="teacher" required> Teacher</label>
          <label><input type="radio" name="requestedType" value="selfpaced"> Self-paced player</label>
        </fieldset>
        <label for="note">Note for the admin</label>
        <textarea id="note" maxlength="500"></textarea>
        <button type="submit">Send request</button>
      </form>
      <p id="request-message" class="message"></p>
      <p><a href="/login">Back to sign in</a></p>
    </div>
  </div>
</section>
<script src="/js/account-request.js"></script>
<%- include('../partials/footer') %>
