<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Classification game</title>
  <link rel="shortcut icon" href="/images/odifavicon32.ico">
  <link href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.css" rel="stylesheet">
  <link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.css" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="/css/chartjsInteractive.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/game-shell.css">
  <link rel="stylesheet" href="/css/cards.css">
  <link rel="stylesheet" href="/css/switch.css">

  <script src="/js/d3.v5.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.js"></script>
  <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.js"></script>
  <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.js"></script>
  <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.js"></script>
  <script src="https://unpkg.com/chart.js@3"></script>
  <script src="https://unpkg.com/@sgratzl/chartjs-chart-boxplot@3"></script>
  <script src="/js/chartjs/controller.js"></script>
  <script src="/js/nav.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/3.1.9-1/core.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/3.1.9-1/md5.js"></script>
  <script src="/js/libraries/Sortable.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jquery-sortablejs@latest/jquery-sortable.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>

  <script src="/js/dragdrop.js"></script>
  <script src="/js/switch.js"></script>
  <script src="/js/tree-score.js"></script>
  <script src="/js/session-tree.js"></script>
  <script src="/js/game-tree.js"></script>
  <script src="/js/cards.js"></script>
  <script src="/js/decision-tree.js"></script>
</head>
<body class="game-page stage-training">
  <header class="header game-header">
    <div class="container">
      <div class="header-top">
        <a href="#play" class="logo toggle-link" aria-label="Open Data Institute"></a>
        <nav class="main-nav" aria-label="Game">
          <ul>
            <li><a href="#instructions" class="toggle-link" data-instructions-open>Instructions</a></li>
            <li><a href="#play" class="toggle-link selected">Play</a></li>
            <li><a href="#about" class="toggle-link">About</a></li>
            <li><a href="#" class="sign-out">Sign out</a></li>
          </ul>
        </nav>
        <div id="pin" class="pinCode game-header-pin"></div>
      </div>
    </div>
  </header>
  <div class="game-main main-content">
    <%- include('../partials/gameInstructions') %>
    <%- include('../partials/tableView') %>
    <%- include('../partials/chartView') %>
    <%- include('../partials/trainingView') %>
    <%- include('../partials/decisionTree') %>
    <%- include('../partials/gameLeaderboards') %>
    <%- include('../partials/about') %>
    <footer id="footer">
      <p>Housing data from R2D3, "A Visual Introduction to Machine Learning" by Stephanie Yee and Tony Chu (<a href="http://www.r2d3.us">http://www.r2d3.us</a>), licensed <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>. Selected, reduced to five features and arranged into card sets by the Open Data Institute.</p>
    </footer>
  </div>
<script type="text/javascript">
  var group = 1;
  var requireEvaluationPin = <%= requireEvaluationPin %>;
  var sessionId = '<%= session %>';
  var leaderboardId = '<%= leaderboardId %>';
  var resultId = '<%= resultId %>';
  var isTutor = <%= isTutor ? 'true' : 'false' %>;
  var entryMode = <%= entryMode ? 'true' : 'false' %>;
  var replayOnly = <%= replayOnly ? 'true' : 'false' %>;
  var evalSetId = <%- JSON.stringify(evalSetId || '') %>;
  var presetTeam = <%- JSON.stringify(teamName || '') %>;
  var player_name = presetTeam || '';
  var attempt = 0;
  var storage = {};
  var predictions = {};
  const randomPin = Math.floor(10000 + Math.random() * 90000);
  let requiredPasscode = 0;

  $('document').ready(function() {
    loadGameData().then(function() {
      initGameTree(window.GAME_FEATURES || []);
      loadStoredTree();
      renderCardsTable(cards.trainingSet);
      chartData = cards.trainingSet;
      if (typeof renderChart === 'function' && document.getElementById('myChart')) {
        renderChart();
      }
      getRandomPurples(20);
      try {
        if (new URLSearchParams(window.location.search).get('resetEval') === '1' &&
            typeof clearEvaluationProgress === 'function') {
          clearEvaluationProgress();
          if (window.history && window.history.replaceState) {
            window.history.replaceState({}, document.title, window.location.pathname);
          }
        }
      } catch (err) {}
      if (leaderboardId && !entryMode) {
        loadLeaderboardData();
      } else if (presetTeam) {
        player_name = presetTeam;
        $('#playerWelcome').text('Welcome ' + player_name);
        $('#playerWelcome').css('display', 'inline');
      } else if (!entryMode) {
        changeName();
      }
      if (entryMode && typeof renderRecordingSheet === 'function') {
        renderRecordingSheet();
      }
      if (replayOnly && typeof setPlayMode === 'function') {
        setPlayMode('evaluation', { force: true });
        if (typeof setEvalFlowChrome === 'function') {
          setEvalFlowChrome('done');
        }
        if (typeof updateEvalActionButtons === 'function') {
          updateEvalActionButtons();
        }
      }
    });

    if (requireEvaluationPin) {
      document.getElementById('pin').textContent = randomPin;
      document.getElementById('pin').style.display = 'block';
      const transformedDigits = [];
      for (let i = 0; i < 4; i++) {
        const digit = parseInt(randomPin.toString()[i]);
        const fifthDigit = parseInt(randomPin.toString()[4]);
        const transformedDigit = (digit * 7 + fifthDigit) % 10;
        transformedDigits.push(transformedDigit);
      }
      requiredPasscode = transformedDigits.join('');
    }

    var groupCsv = document.getElementById('groupcsv');
    var groupPdf = document.getElementById('grouppdf');
    if (groupCsv) groupCsv.href = '/data/csvs/Group_1.csv';
    if (groupPdf) groupPdf.href = '/data/pdfs/Group_1.pdf';

    document.querySelectorAll('.sign-out').forEach(function(link) {
      link.addEventListener('click', function(event) {
        event.preventDefault();
        fetch('/sessions', { method: 'DELETE' }).then(function() {
          window.location = '/login';
        });
      });
    });
  });
</script>
</body>
</html>
