<%- include('../partials/header') %>
<div class="container box">
  <h1>Profile</h1>
  <p><strong>Email</strong>: <%= user.email %></p>
  <p><strong>Account type</strong>: <%= user.type %></p>
  <p><a href="/play">Play the game</a></p>
  <% if (user.type === 'teacher' || user.type === 'admin') { %>
    <p><a href="/leaderboards">Leaderboards</a></p>
  <% } %>
  <% if (user.type === 'admin') { %>
    <p><a href="/accounts">Approve accounts</a></p>
  <% } %>
</div>
<%- include('../partials/footer') %>
