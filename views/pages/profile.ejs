<%- include('../partials/header') %>
<section class="content-block white">
  <div class="container">
    <%- include('../partials/breadcrumbs', {
      crumbs: [{ label: 'Profile' }]
    }) %>
    <div class="page-title"><h1>Profile</h1></div>
    <dl class="detail-list">
      <dt>Email</dt><dd><%= user.email %></dd>
      <dt>Account type</dt><dd><%= user.type %></dd>
      <% if (user.schoolId) { %>
        <dt>School</dt><dd><a href="/schools/<%= user.schoolId %>">Open school</a></dd>
      <% } %>
    </dl>
    <% if (user.type === 'selfpaced') { %>
      <p><a href="/play">Play the game</a></p>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
