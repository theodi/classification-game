<%- include('../../partials/header') %>
<section class="content-block white">
  <div class="container">
    <%- include('../../partials/breadcrumbs', {
      crumbs: [
        { label: 'Schools', href: '/schools' },
        { label: typeof schoolName !== 'undefined' ? schoolName : 'School', href: '/schools/' + id },
        { label: 'Create session' }
      ]
    }) %>
    <div class="page-title"><h1>Create session</h1></div>
    <section class="page-panel">
      <form action="/schools/<%= id %>/sessions" method="post" id="lform" class="detail-form">
        <label for="name">Session name</label>
        <input type="text" id="name" name="name" required>
        <div class="form-actions">
          <button type="submit">Create session</button>
        </div>
      </form>
    </section>
  </div>
</section>
<%- include('../../partials/footer') %>
