<%- include('../../partials/header') %>
<section class="content-block white">
  <div class="container">
    <%- include('../../partials/breadcrumbs', {
      crumbs: [
        { label: 'Schools', href: '/schools' },
        { label: typeof schoolName !== 'undefined' ? schoolName : 'School', href: '/schools/' + id },
        { label: 'Edit session' }
      ]
    }) %>
    <div class="page-title"><h1>Edit session</h1></div>
    <p id="res" class="message"></p>
    <section class="page-panel">
      <form id="lform" class="detail-form">
        <label for="name">Session name</label>
        <input type="text" id="name" name="name" required>
        <dl class="detail-list">
          <dt>Created</dt><dd id="createdAt">—</dd>
        </dl>
        <div class="form-actions">
          <button type="submit">Save</button>
        </div>
      </form>
    </section>
  </div>
</section>
<script>
var schoolId = '<%= id %>';
var sessionId = '<%= sessionId %>';
fetch('/schools/' + schoolId + '/sessions/' + sessionId, { headers: { 'Accept': 'application/json' } })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    document.getElementById('name').value = data.name || '';
    if (data.createdAt) {
      var date = new Date(data.createdAt);
      document.getElementById('createdAt').textContent = Number.isNaN(date.getTime())
        ? '—'
        : date.toISOString().slice(0, 10);
    }
  });
document.getElementById('lform').addEventListener('submit', function(e) {
  e.preventDefault();
  fetch('/schools/' + schoolId + '/sessions/' + sessionId, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ name: document.getElementById('name').value })
  }).then(function(response) {
    document.getElementById('res').textContent = response.ok ? 'Session updated' : 'Error updating session';
  }).catch(function() {
    document.getElementById('res').textContent = 'Error updating session';
  });
});
</script>
<%- include('../../partials/footer') %>
