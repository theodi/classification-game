<%- include('../../partials/header') %>
<section class="content-block white">
  <div class="container">
    <div class="page-title"><h1>Sessions — <span id="school-name"><%= typeof schoolName !== 'undefined' ? schoolName : id %></span></h1></div>
    <p class="stack-row">
      <a class="btn" href="/schools/<%= id %>#sessions-section">Back to school</a>
      <a class="btn" href="/schools/<%= id %>/results">School leaderboard</a>
    </p>
    <p id="message" class="message"><%= typeof msg !== 'undefined' ? msg : '' %></p>
    <section class="page-panel">
      <table class="admin-table" id="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Created</th>
            <th>Results</th>
          </tr>
        </thead>
        <tbody id="table_body"></tbody>
      </table>
    </section>
  </div>
</section>
<script>
var schoolId = '<%= id %>';

fetch('/schools/' + schoolId, { headers: { 'Accept': 'application/json' } })
  .then(function(r) { return r.json(); })
  .then(function(school) {
    document.getElementById('school-name').textContent = school.name;
  });

fetch('/schools/' + schoolId + '/sessions', { headers: { 'Accept': 'application/json' } })
  .then(function(r) { return r.json(); })
  .then(function(rows) {
    return Promise.all(rows.map(function(session) {
      return fetch('/schools/' + schoolId + '/sessions/' + session._id + '/results', {
        headers: { 'Accept': 'application/json' }
      }).then(function(r) { return r.json(); }).then(function(results) {
        session._resultCount = results.length;
        return session;
      });
    }));
  })
  .then(function(rows) {
    var body = document.getElementById('table_body');
    body.innerHTML = '';
    rows.forEach(function(session) {
      var tr = document.createElement('tr');
      tr.className = 'clickable-row';
      tr.dataset.href = '/schools/' + schoolId + '/sessions/' + session._id;
      var created = '—';
      if (session.createdAt) {
        var date = new Date(session.createdAt);
        if (!Number.isNaN(date.getTime())) {
          created = date.toISOString().slice(0, 10);
        }
      }
      tr.innerHTML =
        '<td>' + (session.name || '') + '</td>' +
        '<td>' + created + '</td>' +
        '<td>' + session._resultCount + '</td>';
      body.appendChild(tr);
    });
    initAdminTable('#table', { order: [[1, 'desc']] });
    $('#table tbody').on('click', 'tr.clickable-row', function() {
      var href = $(this).data('href');
      if (href) {
        window.location = href;
      }
    });
  });
</script>
<%- include('../../partials/footer') %>
