<%- include('../../partials/header') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css"/>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<section class="content-block white">
  <div class="container">
    <%- include('../../partials/breadcrumbs', {
      crumbs: [
        { label: 'Schools', href: '/schools' },
        { label: typeof schoolName !== 'undefined' ? schoolName : 'School', href: '/schools/' + id },
        { label: typeof pageTitle !== 'undefined' ? pageTitle : 'Session' }
      ],
      breadcrumbActions: [
        { label: 'Class board', href: '/schools/' + id + '/sessions/' + sessionId + '/board' }
      ]
    }) %>
    <div class="page-title"><h1 id="session-heading">Session</h1></div>
    <p id="session-message" class="message"></p>

    <div class="panel-split">
      <section class="page-panel" id="details-section">
        <h2>Session name</h2>
        <form id="session-name-form" class="detail-form">
          <label for="session-name">Name</label>
          <input id="session-name" name="name" required>
          <p id="details-message" class="message"></p>
          <div class="form-actions">
            <button type="submit">Save name</button>
          </div>
        </form>
      </section>

      <section class="page-panel" id="share-section">
        <h2>Share game link</h2>
        <div class="share-card">
          <div id="game-qr" class="game-qr" aria-label="QR code for game link"></div>
          <button type="button" id="game-link" class="game-link" title="Click to copy"></button>
        </div>
        <div class="section-actions">
          <button type="button" id="open-invite-modal">Send link</button>
        </div>
      </section>
    </div>

    <section class="page-panel" id="results-section">
      <h2>Results</h2>
      <p id="results-empty" class="message hidden">No group results yet.</p>
      <table class="admin-table" id="results-table">
        <thead>
          <tr>
            <th>Team</th>
            <th>Training score</th>
            <th>Written confidence</th>
            <th>Run 1</th>
            <th>Run 2</th>
            <th>Run 3</th>
            <th>Run 4</th>
            <th>Total</th>
            <th>Gap</th>
            <th>Tree</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </section>

    <section class="page-panel" id="add-group-section">
      <h2>Add group submission</h2>
      <p>Enter a team’s tree from the paper recording sheet, then run the evaluation.</p>
      <div class="section-actions">
        <button type="button" id="open-group-modal">Add group submission</button>
      </div>
    </section>

    <section class="page-panel danger-zone" id="danger-section">
      <h2>Danger zone</h2>
      <p>Deleting a session cannot be undone. Sessions with results cannot be deleted.</p>
      <div class="section-actions">
        <button type="button" id="delete-session">Delete session</button>
      </div>
    </section>
  </div>
</section>

<dialog id="invite-modal" class="admin-modal">
  <form method="dialog" id="invite-form" class="admin-modal-card">
    <h2>Send game link</h2>
    <p>Enter one or more email addresses, separated by commas or new lines.</p>
    <label for="invite-emails">Email addresses</label>
    <textarea id="invite-emails" rows="6" required placeholder="student1@school.edu&#10;student2@school.edu"></textarea>
    <p id="invite-message" class="message"></p>
    <div class="form-actions">
      <button type="submit" value="confirm">Send link</button>
      <button type="submit" value="cancel" class="btn-secondary" formnovalidate>Cancel</button>
    </div>
  </form>
</dialog>

<dialog id="group-modal" class="admin-modal admin-modal-wide">
  <div class="admin-modal-card group-tree-card">
    <h2>Add group submission</h2>
    <div class="admin-tree-scroll">
      <div id="group-team-rail" class="group-team-rail detail-form">
        <label for="group-team">Team name</label>
        <input id="group-team" type="text" maxlength="80" required placeholder="Team name">
        <label for="group-confidence">Accuracy</label>
        <input id="group-confidence" type="number" min="0" max="100" step="1" inputmode="decimal" placeholder="%">
      </div>
      <%- include('../../partials/adminDecisionTree') %>
    </div>
    <p id="group-modal-message" class="message"></p>
    <div class="form-actions stack-row">
      <button type="button" id="load-sample-tree">Load sample tree</button>
      <button type="button" id="check-group-tree">Check tree</button>
      <button type="button" id="save-group-tree">Save and evaluate</button>
      <button type="button" id="close-group-modal" class="btn-secondary">Cancel</button>
    </div>
  </div>
</dialog>

<script>
  window.SCHOOL_ID = '<%= id %>';
  window.SESSION_ID = '<%= sessionId %>';
</script>
<script src="/js/tree-score.js"></script>
<script src="/js/session-tree.js"></script>
<script src="/js/session-page.js"></script>
<%- include('../../partials/footer') %>
