<section id="charts" class="hidden">
    <h1 class="visually-hidden">Chart view</h1>
    <p>You can change the chart type and what is plotted using the options.</p>
    <div class="chart-toolbar">
        <div id="chartType" class="chart-type-selector">
            <button type="button" class="chart-button boxplot-chart" data-chart-type="boxplot">
                <span class="icon"><img src="/assets/boxplot-chart-icon.png" alt=""/></span>
                <span class="title">Boxplot</span>
            </button>
            <button type="button" class="chart-button scatter-chart" data-chart-type="scatter">
                <span class="icon"><img src="/assets/scatter-chart-icon.png" alt=""/></span>
                <span class="title">Scatter</span>
            </button>
            <button type="button" class="chart-button histogram-chart" data-chart-type="histogram">
                <span class="icon"><img src="/assets/histogram-chart-icon.png" alt=""/></span>
                <span class="title">Histogram</span>
            </button>
        </div>
    </div>
    <div class="chart-stage">
        <canvas id="myChart" class="chart__widget component__widget" width="800" height="400"></canvas>
        <div class="chart-axis-control chart-axis-control-x" id="chart-axis-x-wrap">
            <label class="visually-hidden" for="xAxis">X axis</label>
            <span id="chart-axis-x-fixed" class="chart-axis-fixed hidden">City</span>
            <select id="xAxis" class="chart-axis-select" aria-label="X axis"></select>
            <div id="binCountSelector" class="chart-bin-control hidden">
                <label class="visually-hidden" for="binCount">Bin count</label>
                <select id="binCount" class="chart-axis-select chart-bin-select" aria-label="Bin count">
                    <option value="1">1 bin</option>
                    <option value="2">2 bins</option>
                    <option value="3">3 bins</option>
                    <option value="4">4 bins</option>
                    <option value="5" selected>5 bins</option>
                    <option value="6">6 bins</option>
                    <option value="7">7 bins</option>
                    <option value="8">8 bins</option>
                    <option value="9">9 bins</option>
                    <option value="10">10 bins</option>
                </select>
            </div>
        </div>
        <div class="chart-axis-control chart-axis-control-y" id="chart-axis-y-wrap">
            <label class="visually-hidden" for="yAxis">Y axis</label>
            <span id="chart-axis-y-fixed" class="chart-axis-fixed hidden">Frequency</span>
            <select id="yAxis" class="chart-axis-select" aria-label="Y axis"></select>
        </div>
    </div>
    <!-- Colour is locked to city; keep select for option population / legacy bindings -->
    <select id="pointColor" class="visually-hidden" tabindex="-1" aria-hidden="true"></select>
</section>
