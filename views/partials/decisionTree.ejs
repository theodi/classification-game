<div id="game-workspace" class="game-workspace">
  <div class="game-deck-chrome" aria-label="Card set" data-deck-float>
    <div class="game-deck-drag-handle" title="Drag to move" aria-label="Move card box"></div>
    <aside class="game-training-deck">
      <div class="game-deck-actions">
        <div id="game-play-actions" class="game-play-actions">
          <button type="button" id="play-primary-action" class="flow-leaf-btn" title="Try your tree with the cards">Run model</button>
          <button type="button" id="rerunEvaluation" class="flow-leaf-btn hidden" name="rerun-evaluation">Re-run evaluation</button>
        </div>
      </div>
      <div class="game-deck-stack-area">
        <div id="training-set" class="cardSet game-deck-stack game-deck-panel" data-browse-all data-deck="training"></div>
        <div id="test-set" class="cardSet game-deck-stack game-deck-panel hidden" data-deck="test"></div>
        <div id="evaluation-set" class="cardSet game-deck-stack game-deck-panel hidden" data-deck="evaluation"></div>
        <div class="game-deck-hover">
          <button type="button" class="flow-leaf-btn game-deck-browse" data-browse-all-cards>Browse cards</button>
          <button type="button" class="flow-leaf-btn game-deck-bring-back" data-bring-cards-back title="Move the cards from the tree back into this box.">Bring cards back</button>
        </div>
      </div>
      <div id="game-run-summary" class="game-run-summary hidden">
        <div id="game-run-summary-scores" class="game-run-summary-scores"></div>
        <div id="game-run-summary-tabs" class="game-run-summary-tabs hidden" role="tablist">
          <button type="button" class="game-run-tab selected" data-summary-view="training" role="tab">Training detail</button>
          <button type="button" class="game-run-tab" data-summary-view="test" role="tab">Test detail</button>
        </div>
        <div id="game-run-summary-body" class="game-run-summary-body"></div>
        <div class="game-run-summary-actions">
          <div class="game-run-summary-actions-row">
            <button type="button" class="flow-leaf-btn" data-back-to-training disabled title="Already in training">Back to training</button>
            <button type="button" class="flow-leaf-btn" data-run-test>Run a test?</button>
          </div>
          <button type="button" class="flow-leaf-btn game-run-submit-eval" data-enter-evaluation>Submit your tree and evaluate</button>
        </div>
      </div>
    </aside>
    <p id="evaluationStatus" class="game-eval-status hidden">Click Evaluate model to obtain a score</p>
  </div>
  <div class="game-workspace-scroll">
    <div id="decision-tree-wrapper" class="game-workspace-tree">
      <div id="game-decision-tree" class="admin-decision-tree game-decision-tree" aria-label="Decision tree"></div>
    </div>
  </div>
</div>
<dialog id="cluster-browse-modal" class="admin-modal cluster-browse-modal" aria-label="Browse cards">
  <div class="admin-modal-card cluster-browse-card">
    <div class="cluster-browse-toolbar">
      <div class="cluster-browse-tabs" role="tablist" aria-label="Browse views">
        <button type="button" class="cluster-browse-tab selected" role="tab" aria-selected="true" data-browse-tab="browse-cards">Cards</button>
        <button type="button" class="cluster-browse-tab" role="tab" aria-selected="false" data-browse-tab="table">Table</button>
        <button type="button" class="cluster-browse-tab" role="tab" aria-selected="false" data-browse-tab="charts">Chart</button>
      </div>
      <div class="cluster-browse-toolbar-actions">
        <div class="cluster-browse-download">
          <button type="button" class="cluster-browse-download-toggle" aria-expanded="false" aria-haspopup="true" data-browse-download-toggle>Download</button>
          <div class="cluster-browse-download-menu" hidden>
            <a id="browse-download-csv" href="#" download="cards.csv">CSV</a>
            <a id="browse-download-pdf" href="/data/pdfs/Group_1.pdf" download="cards.pdf" data-browse-download-pdf>PDF</a>
          </div>
        </div>
        <button type="button" class="btn-secondary" data-cluster-browse-close>Close</button>
      </div>
    </div>
    <iframe id="cluster-browse-frame" title="Browse cards, table and charts"></iframe>
  </div>
</dialog>
