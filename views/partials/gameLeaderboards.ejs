<section id="leaderboards" class="hidden" aria-hidden="true">
  <%# Session board lives in #game-eval-band; keep school/overall tables for data load %>
  <leaderboard id="organisation">
    <table id="organisation-leaderboard" class="display responsive wrap" cellspacing="0" width="100%">
      <thead>
        <tr>
          <th>Rank</th>
          <th>Attempt</th>
          <th>Name</th>
          <th>Score</th>
        </tr>
      </thead>
      <tbody id="organisation-leaderboard-body"></tbody>
    </table>
  </leaderboard>
  <leaderboard id="public">
    <table id="public-leaderboard" class="display responsive wrap" cellspacing="0" width="100%">
      <thead>
        <tr>
          <th>Rank</th>
          <th>Attempt</th>
          <th>Name</th>
          <th>Score</th>
        </tr>
      </thead>
      <tbody id="public-leaderboard-body"></tbody>
    </table>
  </leaderboard>
</section>
