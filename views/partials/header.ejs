<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Classification Game' %></title>
<link rel="shortcut icon" href="/images/odifavicon32.ico">
<link href="/css/water.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" rel="stylesheet">
<link href="/css/admin.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="/js/admin-tables.js"></script>
</head>
<body>
<header class="header">
  <div class="container">
    <div class="header-top">
      <a href="/" class="logo" aria-label="Open Data Institute"></a>
      <nav class="main-nav" aria-label="Main">
        <ul>
          <% if (user) { %>
            <% if (user.type === 'selfpaced') { %>
              <li><a href="/play" class="<%= typeof pageLink !== 'undefined' && pageLink === '/play' ? 'selected' : '' %>">Play</a></li>
            <% } %>
            <% if (user.type === 'teacher' || user.type === 'admin') { %>
              <li><a href="/schools" class="<%= typeof pageLink !== 'undefined' && String(pageLink).indexOf('/schools') === 0 ? 'selected' : '' %>">Schools</a></li>
            <% } %>
            <% if (user.type === 'admin') { %>
              <li><a href="/accounts" class="<%= typeof pageLink !== 'undefined' && pageLink === '/accounts' ? 'selected' : '' %>">Admin</a></li>
            <% } %>
            <li><a href="/profile" class="<%= typeof pageLink !== 'undefined' && pageLink === '/profile' ? 'selected' : '' %>">Profile</a></li>
            <li><a href="/help" class="<%= typeof pageLink !== 'undefined' && pageLink === '/help' ? 'selected' : '' %>">Help</a></li>
            <li><a href="#" class="sign-out">Sign out</a></li>
          <% } else { %>
            <li><a href="/login" class="<%= typeof pageLink !== 'undefined' && pageLink === '/login' ? 'selected' : '' %>">Sign in</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </div>
</header>
<script>
  document.querySelectorAll('.sign-out').forEach(function(link) {
    link.addEventListener('click', function(event) {
      event.preventDefault();
      fetch('/sessions', { method: 'DELETE' }).then(function() {
        window.location = '/login';
      });
    });
  });
</script>
<main class="main-content">
